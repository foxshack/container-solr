#!/bin/bash

set -euo pipefail

core_name="${1:?usage: solr-precreate <core-name> [configset-path]}"
configset="${2:-_default}"
core_dir="${SOLR_HOME}/${core_name}"

if [[ ! -d "$configset" ]]; then
  configset="/opt/solr/server/solr/configsets/${configset}"
fi

if [[ -d "${configset}/conf" ]]; then
  config_dir="${configset}/conf"
else
  config_dir="$configset"
fi

mkdir -p "$core_dir"

if [[ ! -f "${core_dir}/core.properties" ]]; then
  printf 'name=%s\n' "$core_name" > "${core_dir}/core.properties"
fi

if [[ ! -d "${core_dir}/conf" ]]; then
  mkdir -p "${core_dir}/conf"
  cp -a "${config_dir}/." "${core_dir}/conf/"
fi

exec solr-foreground