#!/bin/bash

set -euo pipefail

mkdir -p "$SOLR_HOME" "$SOLR_LOGS_DIR"

if [[ ! -f /var/solr/log4j2.xml ]]; then
  cp /opt/solr/server/resources/log4j2.xml /var/solr/log4j2.xml
fi

exec solr start -f \
  --user-managed \
  -p "${SOLR_PORT:-8983}" \
  --solr-home "$SOLR_HOME" \
  --host "${SOLR_HOST:-0.0.0.0}"